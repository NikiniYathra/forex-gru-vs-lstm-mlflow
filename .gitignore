# Virtual environment
.venv/

# Python cache
__pycache__/
*.pyc

# MLflow local storage (recreated by running the scripts)
mlflow.db
mlruns/

# Large generated arrays (recreated by prepare_sequences.py)
*.npz

# Editor and OS files
.vscode/
.DS_Store
Thumbs.db
runs/

# Regenerable processed data (rebuilt by python -m src.data.preprocess)
data/processed/*/

# Console logs (the results are in MLflow and the CSV summaries)
reports/*_log.txt